# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# .env is already in .gitignore.

# --- Mistral La Plateforme (free "Experiment" tier) ---
# Get a key at https://console.mistral.ai/  (Admin Console -> API Keys)
# Check your live rate limits under Admin Console -> Limits (RPM is the real constraint).
MISTRAL_API_KEY=

# --- Langfuse (observability / tracing) ---
# Self-hosted or cloud (https://cloud.langfuse.com). Free tier is fine.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Optional fallback providers (only if Mistral RPM is too tight) ---
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
